{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://norireader.org/schemas/nori-collection-v1.json",
  "title": "Nori mixed source collection",
  "type": "object",
  "required": ["format", "schemaVersion", "id", "name", "version", "sources"],
  "properties": {
    "format": {"const": "nori-collection"},
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "\\S"},
    "name": {"type": "string", "pattern": "\\S"},
    "version": {"type": "string", "minLength": 1},
    "groups": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "\\S"}
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "description": "A Legado or Nori source, validated by its own protocol after removing collection group metadata.",
        "properties": {
          "group": {"type": ["string", "null"], "description": "Exact group name declared at the collection root; an unmatched name is displayed at the top level."}
        },
        "not": {"required": ["format"], "properties": {"format": {"const": "nori-collection"}}}
      }
    }
  }
}
