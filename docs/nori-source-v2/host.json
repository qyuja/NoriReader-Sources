{
  "format": "nori-source-host",
  "schemaVersion": 1,
  "protocolVersion": 2,
  "sdkVersion": "2.1.0",
  "capabilities": [
    "core-v2",
    "plan-v1",
    "script-v2",
    "http-v1",
    "http-insecure-v1",
    "tls-insecure-v1",
    "http-extended-v1",
    "html-v1",
    "json-v1",
    "css-v1",
    "xpath-v1",
    "jsonpath-v1",
    "regex-v1",
    "auth-web-v1",
    "auth-form-v1",
    "auth-script-v1",
    "state-v1",
    "cache-v1",
    "codec-v1",
    "binary-v1",
    "crypto-v1",
    "zip-v1",
    "url-v1",
    "content-v1",
    "task-v1",
    "diagnostics-v1",
    "crypto-des-v1",
    "auth-request-v1"
  ],
  "limits": {
    "timeoutMs": 30000,
    "scriptTimeMs": 10000,
    "maxRequests": 12,
    "maxConcurrency": 2,
    "maxResponseBytes": 4194304,
    "maxMemoryBytes": 33554432,
    "maxStateBytes": 1048576,
    "maxCacheBytes": 1048576,
    "maxCacheTTLMillis": 2592000000,
    "maxBinaryBytes": 4194304,
    "maxZipEntries": 1024,
    "maxZipExpandedBytes": 16777216
  }
}
